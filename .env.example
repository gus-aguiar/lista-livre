# Copy to .env (never commit it). All values are optional unless noted.
HOST=0.0.0.0
PORT=3000
# Directory for app.sqlite (the named volume in compose.yaml).
DATA_DIR=/data
# Set to the number of proxy hops in front of the app (1 behind Caddy) so
# rate limiting sees the real client IP and cookies get the Secure flag.
TRUST_PROXY=1

# Public demo: isolates lists per anonymous visitor.
DEMO_MODE=1
# Required in demo mode for visitor cookies to survive restarts.
# Generate with: openssl rand -hex 32
DEMO_SECRET=change-me
DEMO_MAX_LISTS=20
DEMO_RATE_LIMIT=30
DEMO_RATE_WINDOW_SECONDS=60
# Demo lists not updated for this many hours are deleted.
DEMO_TTL_HOURS=72
